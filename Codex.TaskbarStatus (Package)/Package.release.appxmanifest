<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity
    Name="Codex.TaskbarStatus.Widget"
    Publisher="CN=Codex Taskbar Status Local"
    Version="1.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Codex Status</DisplayName>
    <PublisherDisplayName>Codex Status</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <!-- The release publish is Windows App SDK self-contained, so this package
       intentionally has no Microsoft.WindowsAppRuntime framework dependency. -->
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.22621.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application
      Id="App"
      Executable="Codex.TaskbarStatus.ExtensionApp.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Codex Status"
        Description="Local Codex execution status in the taskbar."
        BackgroundColor="transparent"
        Square150x150Logo="Images\MediumTile.png"
        Square44x44Logo="Images\AppIcon.png">
        <uap:DefaultTile
          Square71x71Logo="Images\SmallTile.png"
          Wide310x150Logo="Images\WideTile.png"
          Square310x310Logo="Images\LargeTile.png" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension
            Name="com.widbar.widget"
            Id="widget"
            PublicFolder="Public"
            DisplayName="Codex Status"
            Description="Local Codex execution status in the taskbar.">
            <uap3:Properties>
              <WidBarPluginId>com.wille.codex.taskbarstatus</WidBarPluginId>
              <WidBarSdkVersion>2</WidBarSdkVersion>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

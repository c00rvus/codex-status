<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Codex.TaskbarStatus.ExtensionApp</RootNamespace>
    <AssemblyName>Codex.TaskbarStatus.ExtensionApp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- These properties feed the WidBar SDK build target, which writes
       obj\widbar\plugin.json at build time. The packaging project picks that
       file up, so id/name/version only live here. -->
  <PropertyGroup>
    <WidBarPluginId>com.wille.codex.taskbarstatus</WidBarPluginId>
    <WidBarPluginName>Codex Status</WidBarPluginName>
    <WidBarPluginDescription>Local Codex execution status in the taskbar.</WidBarPluginDescription>
    <WidBarPluginCategory>Developer</WidBarPluginCategory>
    <WidBarPluginVersion>1.0.0</WidBarPluginVersion>
    <WidBarPluginPreviewWidth>400</WidBarPluginPreviewWidth>
    <WidBarPluginConfigurable>true</WidBarPluginConfigurable>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="WidBar.SDK" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codex.TaskbarStatus.Core\Codex.TaskbarStatus.Core.csproj" />
  </ItemGroup>

</Project>
